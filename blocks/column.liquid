{% schema %}
{
  "name": "t:names.column",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "width_control",
      "label": "t:settings.width",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:settings.gap",
      "options": [
        {
          "value": "gap-0",
          "label": "t:options.none"
        },
        {
          "value": "gap-4",
          "label": "t:options.normal"
        },
        {
          "value": "gap-8",
          "label": "t:options.wide"
        }
      ],
      "default": "gap-4"
    }
  ],
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "presets": [
    {
      "name": "t:names.column",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}

{%- liquid
  # Convert percentage to Tailwind width class for desktop
  assign width_percent = block.settings.width_control
  assign width_class = 'md:w-full'

  case width_percent
    when 100
      assign width_class = 'md:w-full'
    when 75
      assign width_class = 'md:w-3/4'
    when 66, 67
      assign width_class = 'md:w-2/3'
    when 50
      assign width_class = 'md:w-1/2'
    when 33, 34
      assign width_class = 'md:w-1/3'
    when 25
      assign width_class = 'md:w-1/4'
    when 20
      assign width_class = 'md:w-1/5'
    when 16, 17
      assign width_class = 'md:w-1/6'
    else
      # For custom percentages, fall back to inline style
      assign use_custom_width = true
  endcase

  assign width_class = width_class | append: ' ' | append: block.settings.gap
-%}
{% if use_custom_width %}
  <style>
    @media (min-width: 768px) {
      #block-{{ block.id }} {
        width: var(--column-width) !important;
      }
    }
  </style>
{% endif %}
<div
  id="block-{{ block.id }}"
  class="flex flex-col justify-stretch w-full md:px-2 {{ width_class }}"
  {% if use_custom_width %}
    style="--column-width: {{ block.settings.width_control }}%;"
  {% endif %}
>
  {% content_for 'blocks' %}
</div>
