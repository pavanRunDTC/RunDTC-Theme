{% doc %}
  Megamenu Block
  A dropdown navigation component that displays a full-width menu overlay with organized navigation links and promotional content.

  @example
  {% render 'blocks/megamenu', block: block %}
{% enddoc %}

{% schema %}
{
  "name": "t:names.megamenu",
  "blocks": [
    {
      "type": "_group-navigation"
    }
  ],
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_title",
      "label": "t:names.title",
      "default": "t:text_defaults.menu_item"
    },
    {
      "type": "url",
      "id": "menu_url",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "menu_heading",
      "label": "t:names.heading"
    }
  ],
  "presets": [
    {
      "name": "t:names.megamenu",
      "category": "t:categories.header",
      "settings": {
        "menu_title": "t:text_defaults.shop",
        "menu_heading": "t:text_defaults.menu_heading"
      },
      "blocks": [
        {
          "type": "_group-navigation",
          "blocks": [
            {
              "type": "navigation-menu",
              "settings": {
                "nav_heading": "t:text_defaults.heading"
              }
            },
            {
              "type": "navigation-menu",
              "settings": {
                "nav_heading": "t:text_defaults.heading"
              }
            }
          ]
        }
      ]
    }
  ]
}
{% endschema %}

<div
  class="md:static py-2 sm:py-4 md:py-6 px-4 md:px-5 md:h-full flex items-center cursor-pointer"
  x-load="eager"
  x-load-src="{{ 'build.megamenu.min.js' | asset_url }}"
  x-data="megamenu()"
  x-bind="directives.self"
>
  {% if block.settings.menu_url != blank %}
    <a
      href="{{ block.settings.menu_url | escape }}"
      class="nav-text inline-block sm:block hover:opacity-70 transition-colors cursor-pointer"
      x-bind="directives.menuLink"
    >
      {{ block.settings.menu_title | escape }}
    </a>

  {% else %}
    <span
      class="nav-text block hover:opacity-70 transition-colors cursor-pointer"
      x-bind="directives.menuTrigger"
    >
      {{- block.settings.menu_title | escape -}}
    </span>
  {% endif %}
  {% if block.blocks.size > 0 %}
    <div
      class="megamenu-flyout min-h-full md:p-8 {% if block.settings.menu_heading != blank %} md:pt-0 {% endif %} absolute left-0 top-0 md:top-full z-10 w-full border-t border-solid border-[rgba(205,203,203,0.5)] cursor-auto"
      x-bind="directives.flyout"
      x-cloak
    >
      <div class="w-full px-4 pb-5 md:pb-10">
        <button
          class="pt-3 pb-5 label2 uppercase text-sm font-bold tracking-[0.07rem] flex items-center md:hidden -ml-[6px]"
          x-bind="directives.menuBackButton"
          type="button"
          aria-label="{{ 'general.back' | t | escape }}"
        >
          {% render 'utility-icon', name: 'caret_left', class: 'size-6' %}
          {{ 'general.back' | t }}
        </button>
        {% if block.settings.menu_heading != blank %}
          <h6 class="h6 leading-none tracking-[0.03rem] pb-5 md:py-9">{{ block.settings.menu_heading | escape }}</h6>
        {% endif %}
        <div class="megamenu-content flex flex-col gap-y-6 md:grid md:grid-cols-6 md:gap-x-14 md:gap-y-0">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  {% endif %}
</div>
