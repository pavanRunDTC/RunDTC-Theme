{% schema %}
{
  "name": "t:names.section",
  "tag": "section",
  "blocks": [{ "type": "@theme" }, { "type": "@app" }],
  "settings": [
    {
      "type": "header",
      "content": "t:content.desktop_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.mobile_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "options": [
        {
          "value": "horizontal",
          "label": "t:options.horizontal"
        },
        {
          "value": "vertical",
          "label": "t:options.vertical"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "gap",
      "label": "t:settings.gap",
      "options": [
        {
          "value": "gap-0",
          "label": "t:options.none"
        },
        {
          "value": "gap-4",
          "label": "t:options.normal"
        },
        {
          "value": "gap-8",
          "label": "t:options.wide"
        }
      ],
      "default": "gap-4"
    },
    {
      "type": "checkbox",
      "id": "background_image",
      "label": "t:settings.background",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "t:settings.background_media",
      "visible_if": "{{ section.settings.background_image == true }}",
      "info": "t:info.background_image_info"
    },

    {
      "type": "image_picker",
      "id": "bg_image_mobile",
      "label": "Background media (Mobile)",
      "visible_if": "{{ section.settings.background_image == true }}",
      "info": "Optional: Upload a different image for mobile devices. If not provided, the desktop image will be used."
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:settings.content_alignment",
      "options": [
        {
          "value": "items-start",
          "label": "t:options.top"
        },
        {
          "value": "items-center",
          "label": "t:options.center"
        },
        {
          "value": "items-end",
          "label": "t:options.bottom"
        }
      ],
      "default": "items-center",
      "visible_if": "{{ section.settings.background_image == true and section.settings.bg_image != blank}}"
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "h-[]",
          "label": "t:options.auto"
        },
        {
          "value": "h-[65svh]",
          "label": "t:options.medium"
        },
        {
          "value": "h-[100svh]",
          "label": "t:options.full_screen"
        }
      ],
      "default": "h-[65svh]",
      "visible_if": "{{ section.settings.background_image == true and section.settings.bg_image != blank }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:settings.media_overlay",
      "visible_if": "{{ section.settings.background_image == true and section.settings.bg_image != blank }}"
    },
    {
      "type": "select",
      "id": "overlay_style",
      "label": "t:settings.overlay",
      "options": [
        {
          "value": "solid",
          "label": "t:options.solid"
        },
        {
          "value": "gradient",
          "label": "t:options.gradient"
        }
      ],
      "default": "solid",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.background_image == true and section.settings.bg_image != blank}}"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "t:settings.overlay_color",
      "default": "#000000",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.background_image == true and section.settings.bg_image != blank}}"
    },
    {
      "type": "select",
      "id": "gradient_direction",
      "label": "t:settings.gradient_direction",
      "options": [
        {
          "value": "to top",
          "label": "t:options.up"
        },
        {
          "value": "to bottom",
          "label": "t:options.down"
        }
      ],
      "default": "to bottom",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' and section.settings.background_image == true and section.settings.bg_image != blank}}"
    }
  ],
