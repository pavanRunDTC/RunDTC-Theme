{% schema %}
{
  "name": "t:names.main-activate-account",
  "settings": [
        {
      "type": "header",
      "content": "t:content.desktop_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.mobile_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    }
  ],
  "enabled_on": {
    "templates": ["customers/activate_account"]
  }
}
{% endschema %}
{%- liquid
  assign padding_top_mobile = section.settings.section_padding_top_mobile
  assign padding_bottom_mobile = section.settings.section_padding_bottom_mobile
  assign padding_top_desktop = section.settings.section_padding_top
  assign padding_bottom_desktop = section.settings.section_padding_bottom
-%}
<style>
  #shopify-section-{{ section.id }} {
    --padding-top-desktop: {{ padding_top_desktop }}px;
    --padding-bottom-desktop: {{ padding_bottom_desktop }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .section-wrapper {
    padding-top: var(--padding-top-desktop);
    padding-bottom: var(--padding-bottom-desktop);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .section-wrapper {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
  }
</style>
{%- paginate customer.addresses by 5 -%}
  <div class="section-wrapper color-{{ section.settings.color_scheme }}">
  <div
    class="container section section--narrow text-center"
  >
    <div class="max-w-md mx-auto text-center space-y-2">
      <h2 class="font-bold uppercase mb-6">
        {{ 'customer.activate_account.title' | t }}
      </h2>
      <p class="mb-6">
        {{ 'customer.activate_account.subtext' | t }}
      </p>

      {%- form 'activate_customer_password' -%}
        {%- if form.errors -%}
          <div class="text-error mb-6">
            <h5 tabindex="-1" autofocus>
              {{ 'blocks.contact_form.error_heading' | t }}
            </h5>

            <ul calss="list-disc">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#{{ field }}">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="field">
          <label for="password" class="sr-only">
            {{ 'customer.activate_account.password' | t }}
          </label>
          <input
            type="password"
            name="customer[password]"
            id="password"
            class="w-full input"
            autocomplete="new-password"
            placeholder="{{ 'customer.activate_account.password' | t }}"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="password-error"
            {% endif %}
          >

          {%- if form.errors contains 'password' -%}
            <small id="password-error" class="text-red">
              {{ form.errors.translated_fields.password | capitalize }}
              {{ form.errors.messages.password }}
            </small>
          {%- endif -%}
        </div>

        <div class="field">
          <label for="password_confirmation" class="sr-only">
            {{ 'customer.activate_account.password_confirm' | t }}
          </label>
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            placeholder="{{ 'customer.activate_account.password_confirm' | t }}"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="password_confirmation-error"
            {% endif %}
          >

          {%- if form.errors contains 'password_confirmation' -%}
            <small id="password_confirmation-error">
              {{ form.errors.translated_fields.password_confirmation | capitalize }}
              {{ form.errors.messages.password_confirmation }}
            </small>
          {%- endif -%}
        </div>

        <button class="btn btn-primary btn-black">
          {{ 'customer.activate_account.submit' | t }}
        </button>

        <button class="btn btn-primary" name="decline">
          {{ 'customer.activate_account.cancel' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
  </div>
{%- endpaginate -%}

