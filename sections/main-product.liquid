{% schema %}
{
  "name": "t:names.main_product",
  "enabled_on": {
    "templates": [
      "product"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.product_settings"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "slider",
      "label": "t:settings.enable_slider",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "product-title"
    },
    {
      "type": "product-description"
    },
    {
      "type": "product-price"
    },
    {
      "type": "text"
    },
    {
      "type": "buy-button"
    },
    {
      "type": "product-variant"
    },
    {
      "type": "product-content"
    },
    {
      "type": "product-content-wrapper"
    },
    {
      "type": "accordion"
    }
  ],
  "presets": [
    {
      "name": "t:names.main_product"
    }
  ]
}
{% endschema %}

{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign other_options = null

  for option in product.options_with_values
    assign option_name_downcase = option.name | downcase
    if option_name_downcase contains 'color' or option_name_downcase contains 'colour'
      assign color_option_position = option.position
      assign color_option_name = option.values[0]
      assign color_option_image = option.values[0].swatch.image
      assign color_option_color = option.values[0].swatch.color
    else
      if other_options == null
        assign other_options = option
        assign other_options_position = option.position
      endif
    endif
  endfor

  assign selected_color_image =  null
  if color_option_image
    assign selected_color_image = color_option_image | image_url: width: 48, height: 48
  endif
%}

<div
  class="flex items-start max-md:flex-col gap-4 md:gap-8 color-{{ section.settings.color_scheme }} container py-16"
  x-data='mainProduct({
      mediaCount: {{ product.media | size }},
      variantId: {{ selected_variant.id }},
      addToCartText: {{ 'general.product.add_to_cart' | t | json }},
      soldOutText: {{ 'general.product.sold_out' | t | json }},
      quantityValue: 1,
      variants: {{ product.variants | json }},
      selectedColor: {{ color_option_name | json }},
      selectedColorImage: {{ selected_color_image | json }},
      selectedColorName: {% if color_option_color %}{{ color_option_color | json }}{% else %}""{% endif %},
      selectedOtherOption: {{ other_options.values | first | json }},
      selectedVariantTitle: {{ selected_variant.title | json }},
      selectedVariantAvailable: {{ selected_variant.available | json }},
      colorOptionPosition: {{ color_option_position | default: 0 }},
      otherOptionPosition: {{ other_options_position | default: 0 }},
      moneyFormat: {% if settings.currency_code_enabled %}{{ shop.money_with_currency_format | json }}{% else %}{{ shop.money_format | json }}{% endif %}
    })'
  x-init="{% if section.settings.slider %}initSplide(){% endif %}"
>
  <div class="flex flex-1 md:w-3/5">
    {% render 'product-media', product: product, slider: section.settings.slider %}
  </div>
  <div class="flex flex-col gap-4 sticky top-0 w-full md:w-2/5">
    {% content_for 'blocks' %}
  </div>
</div>
