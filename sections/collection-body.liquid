{%- comment -%}
  Section: Collection Body
{%- endcomment -%}
{% schema %}
{
  "name": "t:names.collection_body",
  "tag": "section",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "blocks": [
    {
      "type": "product-card"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "header",
      "content": "t:content.desktop_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.mobile_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "header",
      "content": "t:content.sort_and_filter"
    },
    {
      "type": "checkbox",
      "id": "enable_filter",
      "label": "t:settings.enable_filter"
    },
    {
      "type": "select",
      "id": "filter_position",
      "label": "t:settings.filter_position",
      "options": [
        {
          "value": "horizontal",
          "label": "t:options.horizontal"
        },
        {
          "value": "vertical",
          "label": "t:options.vertical"
        }
      ],
      "default": "vertical",
      "visible_if": "{{ section.settings.enable_filter == true }}"
    },
    {
      "type": "checkbox",
      "id": "enable_sort",
      "label": "t:settings.enable_sort"
    },
    {
      "type": "header",
      "content": "t:content.product_pagination"
    },
    {
      "type": "checkbox",
      "id": "enable_autoload",
      "label": "t:settings.enable_autoload"
    },
    {
      "type": "number",
      "id": "product_count",
      "label": "t:settings.product_count",
      "default":12
    }
  ],
  "presets": [
    {
      "name": "t:names.collection_body"
    }
  ]
}
{% endschema %}
<script id="sorting-locale" type="application/json">
{
  "featured": "{{ 'collections.sorting.featured' | t }}",
  "a_z": "{{ 'collections.sorting.a_to_z' | t }}",
  "z_a": "{{ 'collections.sorting.z_to_a' | t }}",
  "price_low_high": "{{ 'collections.sorting.price_low_to_high' | t }}",
  "price_high_low": "{{ 'collections.sorting.price_high_to_low' | t }}",
  "newest_first": "{{ 'collections.sorting.newest_first' | t }}",
  "oldest_first": "{{ 'collections.sorting.oldest_first' | t }}",
  "minmax_error": "{{'price_filter.minMaxError' | t }}",
  "maxvalue_error": "{{'price_filter.maxValueError' | t }}",
  "max_greater_than_min": "{{'price_filter.maxGreaterThanMin' | t }}"
}
</script>
{%- liquid
  assign padding_top_mobile = section.settings.section_padding_top_mobile
  assign padding_bottom_mobile = section.settings.section_padding_bottom_mobile
  assign padding_top_desktop = section.settings.section_padding_top
  assign padding_bottom_desktop = section.settings.section_padding_bottom
-%}
<style>
  #shopify-section-{{ section.id }} {
    --padding-top-desktop: {{ padding_top_desktop }}px;
    --padding-bottom-desktop: {{ padding_bottom_desktop }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .section-wrapper {
    padding-top: var(--padding-top-desktop);
    padding-bottom: var(--padding-bottom-desktop);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .section-wrapper {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
  }
  .section-wrapper {
    background-color: var(--color-base-100);
    color: var(--color-base-content);
  }
</style>
<div
  x-data="collectionProductData({collectionHandle: '{{ collection.handle }}',domain: '{{ shop.permanent_domain }}',accessToken: '{{ settings.storefront_access_token }}', productsPerPage: '{{ section.settings.product_count }}', enableAutoLoad: `{{ section.settings.enable_autoload }}`})"
  x-load="eager"
  x-load-src="{{ 'build.product-data.min.js' | asset_url }}"
  class="container section-wrapper relative color-{{ section.settings.color_scheme }}"
>
  {%- if section.settings.enable_filter -%}
    {%- if section.settings.filter_position == 'horizontal' -%}
      <div class="filter-horizontal flex sm:flex-nowrap justify-between items-baseline">
        {%- render 'filter', filter_position: section.settings.filter_position -%}
        {%- if section.settings.enable_sort -%}
          {%- render 'sorting' -%}
        {%- endif -%}
      </div>
    {%- elsif section.settings.filter_position == 'vertical' -%}
      <div class="filter-horizontal flex sm:flex-nowrap justify-between md:justify-end items-baseline">
        {%- render 'filter', filter_position: section.settings.filter_position, class: 'flex md:hidden' -%}
        {%- if section.settings.enable_sort -%}
          {%- render 'sorting', class: '' -%}
        {%- endif -%}
      </div>
    {% endif %}
  {%- else -%}
    {%- if section.settings.enable_sort -%}
      <div class="flex justify-end">
        {%- render 'sorting' -%}
      </div>
    {% endif %}
  {%- endif -%}
  <!-- Loading overlay -->
  <div x-show="loading" class="fixed h-full inset-0 bg-white/70 flex self-center text-center justify-center z-50">
    <span class="loading loading-spinner"></span>
  </div>
  <div class="flex flex-wrap gap-4 mt-4">
    {%- if section.settings.filter_position == 'horizontal' -%}
      {%- render 'selected-filter', filter_position: section.settings.filter_position, class: 'hidden md:flex' -%}
    {% endif %}
    {%- render 'toast' -%}
    {%- if section.settings.enable_filter -%}
      {%- if section.settings.filter_position == 'vertical' -%}
        <aside class="w-full hidden md:block md:w-1/4 lg:w-1/5 shrink-0 self-start">
          {%- render 'filter', filter_position: section.settings.filter_position -%}
        </aside>
      {%- endif -%}
    {%- endif -%}
    <!-- Template container for product cards -->
      <template x-if="products.length === 0 && !loading" x-cloak>
        <div class="grid gap-6 {% if section.settings.filter_position == 'vertical' %}flex-col flex-1 {% else %} flex-row {% endif %} h-full w-full justify-center">
          {%- render 'no-products-found' -%}
        </div>
      </template>
    <template x-if="products && products.length > 0" x-cloak>
      <div
        class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] sm:grid-cols-2 md:grid-cols-3  gap-6 {% if section.settings.filter_position == 'vertical' %}flex-col flex-1 lg:grid-cols-3 {% else %} lg:grid-cols-4 flex-row {% endif %} h-full w-full "
        :key="rerenderKey"
      >
        <template x-for="(product, index) in products" :key="product.id" >
          <div
            class="flex"
            x-data="{ shown: false }"
            x-intersect="shown = true; if (index === products.length - 1 && enableAutoload ) nextPage(true);"
          >
            {% content_for 'block', type: 'product-card', id: 'prod-card', closest.product: product %}
          </div>
        </template>
      </div>
    </template>
    <div class="flex flex-col items-center w-full" x-cloak x-show="!enableAutoload && (hasNextPage || hasPreviousPage)">
      <div class="inline-flex mt-2 xs:mt-0">
        <!-- Buttons -->
        <button
          class="btn btn-neutral btn-xs sm:btn-sm md:btn-md lg:btn-lg s:btn-s mr-4"
          @click="prevPage"
          :disabled="!hasPreviousPage || loading"
        >
          {% render 'utility-icon', name: 'arrow_left', class: 'w-3.5 h-3.5 me-1' %}
          {{ 'general.btnTxt.prev' | t }}
        </button>
        <button
          class="btn btn-neutral btn-xs sm:btn-sm md:btn-md lg:btn-lg s:btn-s"
          @click="nextPage()"
          :disabled="!hasNextPage || loading"
        >
        {{ 'general.btnTxt.nxt' | t }}
        {% render 'utility-icon', name: 'arrow_right', class: 'w-3.5 h-3.5 ms-1' %}
        </button>
      </div>
    </div>
  </div>
</div>