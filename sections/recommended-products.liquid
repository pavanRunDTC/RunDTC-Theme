{% schema %}
{
  "name": "t:names.recommended-prod",
  "tag": "section",
  "blocks": [],
  "class": "recommened-products",
  "settings": [
    {
      "type": "header",
      "content": "t:content.desktop_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.mobile_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "header",
      "content": "t:content.product_recommendation"
    },
    {
      "type": "checkbox",
      "id": "using_api",
      "label": "t:settings.recommended_products_api",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:names.recommended-prod"
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  }
}
{% endschema %}
{%- liquid
  assign padding_top_mobile = section.settings.section_padding_top_mobile
  assign padding_bottom_mobile = section.settings.section_padding_bottom_mobile
  assign padding_top_desktop = section.settings.section_padding_top
  assign padding_bottom_desktop = section.settings.section_padding_bottom
-%}
<style>
  #shopify-section-{{ section.id }} {
    --padding-top-desktop: {{ padding_top_desktop }}px;
    --padding-bottom-desktop: {{ padding_bottom_desktop }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .section-wrapper {
    padding-top: var(--padding-top-desktop);
    padding-bottom: var(--padding-bottom-desktop);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .section-wrapper {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
  }
  .section-wrapper {
    background-color: var(--color-base-100);
    color: var(--color-base-content);
  }
</style>
<div
  class="section-wrapper recommended-product"
  x-data="productRecommendation(
    {
      domain: '{{ shop.permanent_domain }}',
      accessToken: '{{ settings.storefront_access_token }}',
      productId: '{{ product.id }}'
    }
    {% unless section.settings.using_api %}
      ,{
        url: '{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit=4&intent=related'
      }
    {% endunless %}
  )"
  x-load="eager"
  x-load-src="{{ 'build.recommended-product.min.js' | asset_url }}"
>
  <div class="container grid gap-6">
    {% content_for 'block', type: 'text', id: 'section-title' %}
    <div class="grid grid-cols-[repeat(auto-fill,minmax(200px,1fr))] sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-6">
      {%- if section.settings.using_api == false -%}
        {%- assign products = recommendations.products -%}
        {% for product in products %}
          <div >
            {% content_for 'block', type: 'product-card', id: 'static-product-card', closest.product: product %}
          </div>
        {% endfor %}
      {%- else -%}
         <template x-for="product in products.slice(0, 4)" :key="product.id">
          <div class="flex">
            {% content_for 'block', type: 'product-card', id: 'static-product-card-api', closest.product: product %}
          </div>
        </template>
      {%- endif -%}
    </div>
  </div>
</div>