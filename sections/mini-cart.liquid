{% comment %}
  Mini cart drawer section that displays cart contents and allows checkout.
  Opens on cart icon click or when items are added to cart.
  Uses Alpine.js for reactivity and Liquid Ajax Cart for AJAX functionality.
{% endcomment %}

{% schema %}
{
  "name": "t:names.mini_cart",
  "limit": 1,
  "settings": [
    {
      "type": "url",
      "id": "continue_shopping_url",
      "label": "t:settings.continue_shopping_url",
      "info": "t:info.continue_shopping_url"
    }
  ]
}
{% endschema %}

<div
  x-data="{ open: false, isCartPage: window.location.pathname === '{{ routes.cart_url }}' }"
  @cart-open.window="if (!isCartPage) { open = true; $nextTick(() => $el.querySelector('[role=dialog]').focus()); }"
  x-init="document.addEventListener('liquid-ajax-cart:request-end', (event) => {
      if (event.detail.requestState.requestType === 'add' && event.detail.requestState.responseData?.ok) {
        if (!isCartPage) {
          $nextTick(() => { open = true; });
        }
      }
    });"
>
  <!-- Overlay -->
  <div
    x-show="open"
    x-transition:enter="transition-opacity ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition-opacity ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="open = false"
    class="fixed inset-0 bg-black/30 z-50"
    x-cloak
    aria-hidden="true"
  ></div>

  <!-- Mini Cart Drawer -->
  <div
    x-show="open"
    x-transition:enter="transform transition ease-out duration-200"
    x-transition:enter-start="translate-x-full"
    x-transition:enter-end="translate-x-0"
    x-transition:leave="transform transition ease-in duration-150"
    x-transition:leave-start="translate-x-0"
    x-transition:leave-end="translate-x-full"
    @keydown.escape.window="open = false"
    class="fixed top-0 right-0 h-full w-full md:w-96 bg-white shadow-xl z-50"
    data-ajax-cart-section
    role="dialog"
    aria-modal="true"
    aria-labelledby="mini-cart-title"
    tabindex="-1"
    x-cloak
  >
    <div class="flex flex-col h-full">
      <!-- Header -->
      <div class="flex items-center justify-between p-4 border-b border-gray-200">
        <h6 id="mini-cart-title" class="text-sm font-bold">
          {{ 'cart.general.heading' | t }} (<span data-ajax-cart-bind="item_count">{{ cart.item_count }}</span>)
        </h6>
        <button
          type="button"
          @click="open = false"
          class="p-2 hover:bg-gray-100 rounded-full transition-colors cursor-pointer"
          aria-label="{{ 'cart.general.close_cart' | t }}"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      {% if cart.item_count > 0 %}
        <!-- Cart Items -->
        <div class="flex-1 overflow-y-auto p-4 space-y-4" data-ajax-cart-section-scroll>
          {% for line_item in cart.items %}
            {% assign line_item_index = forloop.index %}

            <div class="flex gap-3 pb-4 border-b border-gray-100 last:border-b-0">
              <!-- Product Image -->
              <div class="flex-shrink-0">
                {% if line_item.image %}
                  <a href="{{ line_item.variant.url }}">
                    <img
                      src="{{ line_item.image | image_url: width: 80 }}"
                      alt="{{ line_item.title | escape }}"
                      width="80"
                      height="80"
                      class="rounded object-cover"
                      loading="lazy"
                    >
                  </a>
                {% else %}
                  <div class="w-20 h-20 bg-gray-200 rounded flex items-center justify-center">
                    <span class="text-xs text-gray-400">{{ 'cart.general.no_image' | t }}</span>
                  </div>
                {% endif %}
              </div>

              <!-- Product Details -->
              <div class="flex-1 min-w-0 flex flex-col">
                <!-- Title Row -->
                <div class="flex items-start justify-between gap-2 mb-1">
                  <div class="flex-1 min-w-0">
                    <a href="{{ line_item.variant.url }}" class="text-sm font-medium hover:underline block">
                      {{ line_item.product.title | escape }}
                    </a>
                    {% if line_item.product.has_only_default_variant == false %}
                      <p class="text-xs text-gray-600 mt-0.5">{{ line_item.variant.title }}</p>
                    {% endif %}
                  </div>
                  {% if line_item.quantity > 1 %}
                    <div class="text-sm font-medium whitespace-nowrap">
                      {% if settings.currency_code_enabled %}
                        {{ line_item.line_price | money_with_currency }}
                      {% else %}
                        {{ line_item.line_price | money }}
                      {% endif %}
                    </div>
                  {% endif %}
                </div>

                <!-- Price Row -->
                <div class="mb-2">
                  <div class="text-sm">
                    {% if line_item.variant.compare_at_price > line_item.final_price %}
                      <span class="text-xs text-gray-400 line-through mr-1.5">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.variant.compare_at_price | money_with_currency }}
                        {% else %}
                          {{ line_item.variant.compare_at_price | money }}
                        {% endif %}
                      </span>
                      <span class="font-medium">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.final_price | money_with_currency }}
                        {% else %}
                          {{ line_item.final_price | money }}
                        {% endif %}
                      </span>
                    {% elsif line_item.original_price != line_item.final_price %}
                      <span class="text-xs text-gray-400 line-through mr-1.5">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.original_price | money_with_currency }}
                        {% else %}
                          {{ line_item.original_price | money }}
                        {% endif %}
                      </span>
                      <span class="font-medium">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.final_price | money_with_currency }}
                        {% else %}
                          {{ line_item.final_price | money }}
                        {% endif %}
                      </span>
                    {% else %}
                      <span class="font-medium">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.final_price | money_with_currency }}
                        {% else %}
                          {{ line_item.final_price | money }}
                        {% endif %}
                      </span>
                    {% endif %}
                  </div>
                </div>

                <!-- Quantity and Remove Row -->
                <div class="flex items-center justify-between mt-auto">
                  <ajax-cart-quantity>
                    <div class="flex items-center gap-0.5 border border-gray-200 rounded-md overflow-hidden bg-white">
                      <button
                        type="button"
                        data-ajax-cart-quantity-minus
                        class="px-3 py-1.5 hover:bg-gray-50 transition-colors cursor-pointer text-gray-600"
                        aria-label="{{ 'cart.general.decrease_quantity' | t }}"
                      >
                        <span class="text-base leading-none">−</span>
                      </button>

                      <input
                        data-ajax-cart-quantity-input="{{ line_item_index }}"
                        name="updates[]"
                        value="{{ line_item.quantity }}"
                        type="number"
                        min="0"
                        class="w-12 text-center text-sm py-1.5 focus:outline-none border-none bg-transparent [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                        aria-label="{{ 'cart.general.quantity' | t }}"
                        form="mini-cart-form"
                      >

                      <button
                        type="button"
                        data-ajax-cart-quantity-plus
                        class="px-3 py-1.5 hover:bg-gray-50 transition-colors cursor-pointer text-gray-600"
                        aria-label="{{ 'cart.general.increase_quantity' | t }}"
                      >
                        <span class="text-base leading-none">+</span>
                      </button>
                    </div>
                  </ajax-cart-quantity>

                  <a
                    href="{{ line_item.url_to_remove }}"
                    data-ajax-cart-request-button
                    aria-label="{{ 'cart.general.remove' | t }} {{ line_item.title }}"
                    class="text-xs underline cursor-pointer transition-colors"
                  >
                    {{ 'cart.general.remove' | t }}
                  </a>
                </div>

                <!-- Error Messages -->
                <div class="mt-1 text-xs text-red-600" data-ajax-cart-errors="{{ line_item.key }}"></div>
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Footer -->
        <div class="border-t border-gray-200 p-4 space-y-4">
          <!-- Subtotal -->
          <div class="flex justify-between text-base font-semibold">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span data-ajax-cart-bind-state="cart.total_price | {% if settings.currency_code_enabled %}money_with_currency{% else %}money{% endif %}">
              {% if settings.currency_code_enabled %}
                {{ cart.total_price | money_with_currency }}
              {% else %}
                {{ cart.total_price | money }}
              {% endif %}
            </span>
          </div>

          <p class="text-xs text-gray-600">
            {{ 'cart.general.taxes_shipping_notice' | t }}
          </p>

          <!-- Buttons -->
          <div class="space-y-2">
            {% form 'cart', cart, id: 'mini-cart-form' %}
              <button
                type="submit"
                name="checkout"
                class="w-full btn btn-primary btn-lg transition-colors cursor-pointer"
              >
                {{ 'cart.general.checkout' | t }}
              </button>
            {% endform %}

            <a
              href="{{ routes.cart_url }}"
              class="w-full text-center border border-gray-300 btn btn-secondary btn-lg transition-colors cursor-pointer"
            >
              {{ 'cart.mini_cart.view_cart' | t }}
            </a>
          </div>
        </div>
      {% else %}
        <!-- Empty Cart -->
        <div class="flex-1 flex flex-col items-center justify-center p-8">
          <svg class="w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <p class="text-gray-600 mb-4">{{ 'cart.general.empty_cart' | t }}</p>
          {% if section.settings.continue_shopping_url != blank %}
            <a
              href="{{ section.settings.continue_shopping_url }}"
              class="btn btn-primary py-2 px-6 rounded-md font-semibold cursor-pointer"
            >
              {{ 'cart.general.continue_shopping' | t }}
            </a>
          {% else %}
            <button
              type="button"
              @click="open = false"
              class="btn btn-primary py-2 px-6 rounded-md font-semibold cursor-pointer"
            >
              {{ 'cart.general.continue_shopping' | t }}
            </button>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</div>
