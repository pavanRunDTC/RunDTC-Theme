{% comment %}
  Full cart page displaying all cart items with quantity controls and order summary.
  Includes discount display, cart notes, and checkout button.
  Uses Liquid Ajax Cart for AJAX updates without page refresh.
{% endcomment %}

<div
  class="container py-8"
  data-ajax-cart-section
>
  {% if cart.item_count > 0 %}
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 lg:gap-12">
      <!-- Left Column: Title and Cart Items -->
      <div class="lg:col-span-2">
        <div class="mb-6 pb-4 border-b border-gray-400 text-{{ section.settings.heading_alignment }}">
          <div class="text-4xl font-bold mb-1">{{ 'cart.general.heading' | t }}</div>
          <p class="text-sm">{{ 'cart.cart_page.item_count' | t: count: cart.item_count }}</p>
        </div>

        <div class="cart-items-wrapper color-{{ section.settings.cart_color_scheme }}" data-ajax-cart-section-scroll>
          {% for line_item in cart.items %}
            {% assign line_item_index = forloop.index %}

            <div class="cart-item border-b border-gray-400 pb-4 mb-4 last:border-b-0 last:mb-0 last:pb-0">
              <div class="flex gap-3 md:gap-4">
                <!-- Product Image -->
                <div class="flex-shrink-0">
                  {% if line_item.image %}
                    <a href="{{ line_item.variant.url }}">
                      <img
                        src="{{ line_item.image | image_url: width: 192 }}"
                        alt="{{ line_item.title | escape }}"
                        width="80"
                        height="80"
                        class="max-w-48 md:max-w-100 rounded object-cover"
                        loading="lazy"
                      >
                    </a>
                  {% else %}
                    <div class="w-20 h-20 md:w-48 md:h-48 bg-gray-200 rounded flex items-center justify-center">
                      <span class="text-xs text-gray-400">{{ 'cart.general.no_image' | t }}</span>
                    </div>
                  {% endif %}
                </div>

                <!-- Product Details -->
                <div class="flex-1 min-w-0 flex flex-col">
                  <!-- Title Row -->
                  <div class="flex items-start justify-between gap-2 mb-1">
                    <div class="flex-1 min-w-0">
                      <a href="{{ line_item.variant.url }}" class="text-sm font-medium hover:underline block">
                        {{ line_item.product.title | escape }}
                      </a>
                      {% if line_item.product.has_only_default_variant == false %}
                        <p class="text-xs text-gray-600 mt-0.5">{{ line_item.variant.title }}</p>
                      {% endif %}

                      {% if line_item.selling_plan_allocation %}
                        <p class="text-sm mt-1">
                          {{ line_item.selling_plan_allocation.selling_plan.name }}
                        </p>
                      {% endif %}

                      {% if line_item.properties.size > 0 %}
                        <div class="text-sm text-gray-600 mt-1">
                          {% for property in line_item.properties %}
                            {% assign property_first_char = property.first | slice: 0 %}
                            {% unless property.last == blank or property_first_char == '_' %}
                              <p>{{ property.first }}: {{ property.last }}</p>
                            {% endunless %}
                          {% endfor %}
                        </div>
                      {% endif %}
                    </div>

                    <!-- Line Total -->
                    <div class="text-right">
                      {% if line_item.original_line_price != line_item.final_line_price %}
                        <span class="block text-xs text-gray-400 line-through">
                          {% if settings.currency_code_enabled %}
                            {{ line_item.original_line_price | money_with_currency }}
                          {% else %}
                            {{ line_item.original_line_price | money }}
                          {% endif %}
                        </span>
                        <span class="block text-base font-semibold">
                          {% if settings.currency_code_enabled %}
                            {{ line_item.final_line_price | money_with_currency }}
                          {% else %}
                            {{ line_item.final_line_price | money }}
                          {% endif %}
                        </span>
                      {% else %}
                        <span class="block text-base font-semibold">
                          {% if settings.currency_code_enabled %}
                            {{ line_item.final_line_price | money_with_currency }}
                          {% else %}
                            {{ line_item.final_line_price | money }}
                          {% endif %}
                        </span>
                      {% endif %}
                    </div>
                  </div>

                  <!-- Unit Price -->
                  <div class="mb-2">
                    {% if line_item.variant.compare_at_price > line_item.final_price %}
                      <span class="text-xs text-gray-400 line-through mr-1.5">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.variant.compare_at_price | money_with_currency }}
                        {% else %}
                          {{ line_item.variant.compare_at_price | money }}
                        {% endif %}
                      </span>
                      <span class="text-sm font-medium">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.final_price | money_with_currency }}
                        {% else %}
                          {{ line_item.final_price | money }}
                        {% endif %}
                      </span>
                    {% elsif line_item.original_price != line_item.final_price %}
                      <span class="text-xs text-gray-400 line-through mr-1.5">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.original_price | money_with_currency }}
                        {% else %}
                          {{ line_item.original_price | money }}
                        {% endif %}
                      </span>
                      <span class="text-sm font-medium">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.final_price | money_with_currency }}
                        {% else %}
                          {{ line_item.final_price | money }}
                        {% endif %}
                      </span>
                    {% else %}
                      <span class="text-sm font-medium">
                        {% if settings.currency_code_enabled %}
                          {{ line_item.final_price | money_with_currency }}
                        {% else %}
                          {{ line_item.final_price | money }}
                        {% endif %}
                      </span>
                    {% endif %}
                  </div>

                  {% if line_item.line_level_discount_allocations.size > 0 %}
                    <ul class="mb-2">
                      {% for discount_allocation in line_item.line_level_discount_allocations %}
                        <li class="text-xs text-green-600">
                          {{ discount_allocation.discount_application.title }} (-
                          {%- if settings.currency_code_enabled -%}
                            {{- discount_allocation.amount | money_with_currency -}}
                          {%- else -%}
                            {{- discount_allocation.amount | money -}}
                          {%- endif -%}
                          )
                        </li>
                      {% endfor %}
                    </ul>
                  {% endif %}

                  <!-- In Stock Indicator (Mobile) -->
                  {% if line_item.variant.available %}
                    <div class="flex items-center gap-1.5 mb-2 md:hidden">
                      <svg class="w-3.5 h-3.5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-xs text-green-600 font-medium">{{ 'cart.cart_page.in_stock' | t }}</span>
                    </div>
                  {% endif %}

                  <!-- Quantity and Remove Row -->
                  <div class="flex items-center justify-between mt-auto">
                    <ajax-cart-quantity>
                      <div class="flex items-center gap-0.5 border border-gray-400 rounded-md overflow-hidden bg-white">
                        <button
                          type="button"
                          data-ajax-cart-quantity-minus
                          class="px-3 py-1.5 hover:bg-gray-50 transition-colors cursor-pointer text-gray-600"
                          aria-label="{{ 'cart.general.decrease_quantity' | t }}"
                        >
                          <span class="text-base leading-none">−</span>
                        </button>

                        <input
                          data-ajax-cart-quantity-input="{{ line_item_index }}"
                          name="updates[]"
                          value="{{ line_item.quantity }}"
                          type="number"
                          min="0"
                          class="w-12 text-center text-sm py-1.5 focus:outline-none border-none bg-transparent [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                          aria-label="{{ 'cart.general.quantity' | t }}"
                          form="cart-form"
                        >

                        <button
                          type="button"
                          data-ajax-cart-quantity-plus
                          class="px-3 py-1.5 hover:bg-gray-50 transition-colors cursor-pointer text-gray-600"
                          aria-label="{{ 'cart.general.increase_quantity' | t }}"
                        >
                          <span class="text-base leading-none">+</span>
                        </button>
                      </div>
                    </ajax-cart-quantity>

                    <!-- Remove Button -->
                    <a
                      href="{{ line_item.url_to_remove }}"
                      data-ajax-cart-request-button
                      aria-label="{{ 'cart.general.remove' | t }} {{ line_item.title }}"
                      class="text-gray-400 hover:text-red-600 transition-colors cursor-pointer"
                    >
                      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                      </svg>
                    </a>
                  </div>

                  <!-- In Stock Indicator (Desktop) -->
                  {% if line_item.variant.available %}
                    <div class="hidden md:flex items-center gap-1.5 mt-2">
                      <svg class="w-3.5 h-3.5 text-green-600" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-xs text-green-600 font-medium">{{ 'cart.cart_page.in_stock' | t }}</span>
                    </div>
                  {% endif %}

                  <!-- Error Messages -->
                  <div class="mt-2 text-sm text-red-600" data-ajax-cart-errors="{{ line_item.key }}"></div>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      <!-- Right Column: Order Summary -->
      <div class="lg:col-span-1">
        <div class="order-summary-wrapper color-{{ section.settings.summary_color_scheme }} rounded-lg p-5 sticky top-4">
          <div class="text-lg font-bold mb-4">{{ 'cart.cart_page.order_summary' | t }}</div>

          <div class="space-y-2.5 mb-4">
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">{{ 'cart.general.subtotal' | t }}</span>
              <span class="font-medium">
                {% if settings.currency_code_enabled %}
                  {{ cart.items_subtotal_price | money_with_currency }}
                {% else %}
                  {{ cart.items_subtotal_price | money }}
                {% endif %}
              </span>
            </div>

            {% if cart.cart_level_discount_applications.size > 0 %}
              {% for discount_application in cart.cart_level_discount_applications %}
                <div class="flex justify-between text-xs text-green-600">
                  <span>{{ discount_application.title }}</span>
                  <span
                    >-
                    {%- if settings.currency_code_enabled -%}
                      {{- discount_application.total_allocated_amount | money_with_currency -}}
                    {%- else -%}
                      {{- discount_application.total_allocated_amount | money -}}
                    {%- endif -%}
                  </span>
                </div>
              {% endfor %}
            {% endif %}

            {% if cart.total_discount > 0 %}
              <div class="flex justify-between text-xs text-green-600">
                <span>{{ 'cart.cart_page.total_discounts' | t }}</span>
                <span
                  >-
                  {%- if settings.currency_code_enabled -%}
                    {{- cart.total_discount | money_with_currency -}}
                  {%- else -%}
                    {{- cart.total_discount | money -}}
                  {%- endif -%}
                </span>
              </div>
            {% endif %}
          </div>

          <div class="border-t border-gray-400 pt-3 mb-4">
            <div class="flex justify-between text-base font-bold">
              <span>{{ 'cart.cart_page.total' | t }}</span>
              <span>
                {% if settings.currency_code_enabled %}
                  {{ cart.total_price | money_with_currency }}
                {% else %}
                  {{ cart.total_price | money }}
                {% endif %}
              </span>
            </div>
            <p class="text-xs mt-1.5">
              {{ 'cart.general.taxes_shipping_notice' | t }}
            </p>
          </div>

          <!-- Order Notes -->
          <div class="mb-4">
            <label for="cart-note" class="block text-xs font-medium mb-1.5">
              {{ 'cart.cart_page.order_notes_label' | t }}
            </label>
            <textarea
              id="cart-note"
              name="note"
              data-ajax-cart-property-input
              form="cart-form"
              rows="3"
              class="w-full px-3 py-2 text-sm border border-gray-400 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500"
              placeholder="{{ 'cart.cart_page.order_notes_placeholder' | t }}"
            >{{ cart.note }}</textarea>
          </div>

          <!-- Checkout Button -->
          {% form 'cart', cart, id: 'cart-form' %}
            <button
              type="submit"
              name="checkout"
              class="w-full btn btn-primary btn-lg transition-colors cursor-pointer"
            >
              {{ 'cart.cart_page.checkout' | t }}
            </button>
          {% endform %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="text-center py-16 space-y-6">
      <h2 class="mb-4">{{ 'cart.cart_page.empty_cart' | t }}</h2>
      <a
        href="{% if section.settings.continue_shopping_url != blank %}{{ section.settings.continue_shopping_url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
        class="btn btn-primary btn-lg font-semibold transition-colors"
      >
        {{ 'cart.general.continue_shopping' | t }}
      </a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:names.cart",
  "tag": "section",
  "class": "section-cart",
  "enabled_on": {
    "templates": [
      "cart"
    ]
  },
  "settings": [
    {
      "type": "url",
      "id": "continue_shopping_url",
      "label": "t:settings.continue_shopping_url",
      "info": "t:info.continue_shopping_url"
    },
    {
      "type": "header",
      "content": "t:content.heading"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:settings.heading_alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.cart_items"
    },
    {
      "type": "color_scheme",
      "id": "cart_color_scheme",
      "label": "t:settings.cart_color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.order_summary"
    },
    {
      "type": "color_scheme",
      "id": "summary_color_scheme",
      "label": "t:settings.summary_color_scheme",
      "default": "scheme-2"
    }
  ],
  "presets": [
    {
      "name": "t:names.cart"
    }
  ]
}
{% endschema %}

{% stylesheet %}
  .cart-items-wrapper {
    background-color: var(--color-base-100);
    color: var(--color-base-content);
  }

  .cart-item {
    background-color: var(--color-base-100);
  }

  .order-summary-wrapper {
    background-color: var(--color-base-100);
    color: var(--color-base-content);
  }
{% endstylesheet %}
