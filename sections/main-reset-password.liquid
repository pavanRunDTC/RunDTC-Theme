{% schema %}
{
  "name": "t:names.main-reset-password",
  "settings": [
      {
      "type": "header",
      "content": "t:content.desktop_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "default": 60,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "t:content.mobile_padding"
    },
    {
      "type": "range",
      "id": "section_padding_top_mobile",
      "label": "t:settings.section_padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_bottom_mobile",
      "label": "t:settings.section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 40,
      "unit": "px"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme"
    }
  ],
  "enabled_on": {
    "templates": ["customers/reset_password"]
  }
}
{% endschema %}
{%- liquid
  assign padding_top_mobile = section.settings.section_padding_top_mobile
  assign padding_bottom_mobile = section.settings.section_padding_bottom_mobile
  assign padding_top_desktop = section.settings.section_padding_top
  assign padding_bottom_desktop = section.settings.section_padding_bottom
-%}
<style>
  #shopify-section-{{ section.id }} {
    --padding-top-desktop: {{ padding_top_desktop }}px;
    --padding-bottom-desktop: {{ padding_bottom_desktop }}px;
    --padding-top-mobile: {{ padding_top_mobile }}px;
    --padding-bottom-mobile: {{ padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .section-wrapper {
    padding-top: var(--padding-top-desktop);
    padding-bottom: var(--padding-bottom-desktop);
  }

  @media (max-width: 768px) {
    #shopify-section-{{ section.id }} .section-wrapper {
      padding-top: var(--padding-top-mobile);
      padding-bottom: var(--padding-bottom-mobile);
    }
  }
</style>
  <div
    class="section section-wrapper container section--narrow text-center color-{{ section.settings.color_scheme }}"
  >
    <div class="max-w-md mx-auto text-center space-y-2">
      <h4>
        {{ 'customer.reset_password.title' | t }}
      </h4>
      
      {%- form 'reset_customer_password' -%}
        {%- if form.errors -%}
          <div class="mb-6 text-error text-left">
            <p class="text-error" tabindex="-1" autofocus>
              <span class="sr-only">{{ 'accessibility.error' | t }} </span>
              {{ 'blocks.contact_form.error_heading' | t }}
            </p>

            <ul class="list-disc pl-4">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#{{ field }}">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <p class="text-left">
          {{ 'customer.reset_password.subtext' | t }}
        </p>
        <div class="field mb-6">
          <input
            type="password"
            name="customer[password]"
            id="password"
            autocomplete="new-password"
            class="w-full input"
            {% if form.errors contains 'password' %}
              aria-invalid="true"
              aria-describedby="password-error"
            {% endif %}
            placeholder="{{ 'customer.reset_password.password' | t }}"
          >
          <label class="sr-only" for="password">
            {{ 'customer.reset_password.password' | t }}
          </label>
        </div>

        <div class="field mb-6">
          <input
            type="password"
            name="customer[password_confirmation]"
            id="password_confirmation"
            autocomplete="new-password"
            class="w-full input"
            {% if form.errors contains 'password_confirmation' %}
              aria-invalid="true"
              aria-describedby="password_confirmation-error"
            {% endif %}
            placeholder="{{ 'customer.reset_password.password_confirm' | t }}"
          >
          <label class="sr-only" for="password_confirmation">
            {{ 'customer.reset_password.password_confirm' | t }}
          </label>
          {%- if form.errors contains 'password_confirmation' -%}
            <small id="password_confirmation-error" class="text-red">
              {{ form.errors.translated_fields.password_confirmation | capitalize }}
              {{ form.errors.messages.password_confirmation }}
            </small>
          {%- endif -%}
        </div>

        <button class="btn btn-primary btn-black">
          {{ 'customer.reset_password.submit' | t }}
        </button>
      {%- endform -%}
    </div>
  </div>
