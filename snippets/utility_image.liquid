{% doc %}
  Renders a responsive image that might be wrapped in a link.

  When `width`, `height` and `crop` are provided, the image will be rendered
  with a fixed aspect ratio.

  See the `image_url` filter to see which crop values are available:
  🔗 https://shopify.dev/docs/api/liquid/filters/image_url#image_url-crop

  Adapted from the Shopify Skeleton Theme:
  🔗 https://github.com/Shopify/skeleton-theme/blob/main/snippets/image.liquid

  @param {image} image - The image to be rendered
  @param {string} [url] - An optional destination URL for the image
  @param {string} [class] - Optional class to be added to the image wrapper
  @param {string} [image_class] - Optional class to be added to the image wrapper
  @param {number} [width] - The highest resolution width of the image to be rendered
  @param {number} [height] - The highest resolution height of the image to be rendered
  @param {string} [crop] - The crop position of the image

  @example
  {% render 'utility_image', image: product.featured_image %}
  {% render 'utility_image', image: product.featured_image, url: product.url %}
  {% render 'utility_image',
    class: 'w-6 lg:w-75',
    image_class: 'object-cover w-full h-full',
    image: product.featured_image,
    url: product.url,
    width: 1200,
    height: 800,
    crop: 'center',
  %}
{% enddoc %}

{% liquid
  unless height
    assign width = width | default: image.width
  endunless

  if url
    assign wrapper = 'a'
  else
    assign wrapper = 'div'
  endif

  # Image widths for srcset in increments of 200px
  # This allows the browser to select the best resolution based on the device's pixel density.
  # Shopify will only output sizes up until the image's maximum width.
  # Prebaking these widths is an optimization technique, meant to reduce Liquid processing time.
  assign widths = '200, 400, 600, 800, 1000, 1200, 1400, 1600, 1800, 2000, 2200, 2400, 2600, 2800, 3000, 3200, 3400, 3600, 3800, 4000, 4200, 4400'
%}

<{{ wrapper }}
  class="image {{ class }}"
  {% if url %}
    href="{{ url }}"
  {% endif %}
>
  {{ image | image_url: width: width, height: height, crop: crop | image_tag: widths: widths, class: image_class }}
</{{ wrapper }}>
